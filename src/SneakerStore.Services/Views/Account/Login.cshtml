@model SneakerStore.Services.Dtos.LoginRequest

@{
	ViewData["Title"] = "Login";
}

<link rel="stylesheet" href="~/css/account.css"/>

<div class="account-container">
	<div class="account-card">

		<div class="account-header">

			<div class="account-logo">
				👟
			</div>

			<h1>Welcome Back</h1>
			<p>Sign in to your Account</p>
		</div>

		<form asp-action="Login" method="post" class="account-form">
			<div asp-validation-summary="ModelOnly" class="validation"></div>

			<div class="form-group">

				<label asp-for="Email" class="form-label"></label>

				<input asp-for="Email" class="form-control"/>

				<span asp-validation-for="Email" class="text-danger"></span>
			</div>

			<div class="form-group">

				<label asp-for="Password" class="form-label"></label>

				<div class="password-wrapper">

					<input asp-for="Password"
					type="password"
					id="loginPassword"
					class="form-control password-input" />

					<button type="button"
							class="password-toggle"
							data-target="loginPassword"
							aria-label="Toggle Password"
					>
						<i class="bi bi-emoji-dizzy"></i>
					</button>

				</div>

				<span asp-validation-for="Password" class="text-danger"></span>

			</div>

			<button type="submit" class="button button-primary account-submit">
				Login
			</button>

			<div class="account-divider">
				<span>OR</span>
			</div>

		</form>

		<div class="account-links">

				
				
				<a asp-action="ForgotPassword">
					Forgot Password?
				</a>


				<a asp-controller="Account"
					asp-action="Register"
				>
					Register
				</a>
		</div>
	</div>
</div>

@section Scripts {

	<partial name="_ValidationScriptsPartial" />

	<script src="~/js/passwordToggle.js" asp-append-version="true"></script>

}

