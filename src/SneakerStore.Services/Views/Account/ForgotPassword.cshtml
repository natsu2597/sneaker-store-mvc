@model SneakerStore.Services.Dtos.ForgotPasswordRequest

@{
	ViewData["Title"] = "Forgot Password";
}

@section Styles{
	<link rel="stylesheet"
			href="~/css/account.css"
			asp-append-version="true"
		/>
}

<div class="account-container">
	<div class="account-card">
		<div class="account-header">
			<div class="account-logo">
				👟
			</div>

			<h2>Forgot Password</h2>

			<p>Enter your email and we will send a password reset link.</p>
		</div>

		<form asp-action="ForgotPassword" method="post" class="account-form">

			<div asp-validation-summary="ModelOnly" class="text-danger"></div>

			<div class="form-group">

				<label asp-for="Email" class="form-label">
					Email Address
				</label>

				<input asp-for="Email"  class="form-control" placeholder="Enter your email"/>

				<span asp-validation-for="Email" class="text-danger"></span>
			</div>

			<button type="submit" class="button button-primary account-submit">
				Send Reset Link
			</button>

			<div class="account-links">
				<p>
					Remember Password?
					<a asp-action="Login">
						Back to Login
					</a>
				</p>
			</div>

		</form>
	</div>	
</div>


@section Scripts {

	<partial name="_ValidationScriptsPartial" />

}